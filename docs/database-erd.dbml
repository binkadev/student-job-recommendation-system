Project student_job_recommendation {
  database_type: 'PostgreSQL'
  Note: 'Released Flyway V1-V18. Partial indexes, predicates, index sort direction and CHECK semantics are documented in table notes and database-schema.md rather than approximated as ordinary unique constraints.'
}

Table users {
  id bigint [pk, increment]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  full_name varchar(255) [not null]
  phone varchar(50)
  role varchar(50) [not null]
  status varchar(50) [not null, default: 'ACTIVE']
  last_login_at timestamp
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    role [name: 'idx_users_role']
    status [name: 'idx_users_status']
    last_login_at [name: 'idx_users_last_login_at']
  }
}

Table students {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  student_code varchar(100)
  university varchar(255)
  major varchar(255)
  graduation_year integer
  location varchar(255)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table student_profiles {
  id bigint [pk, increment]
  student_id bigint [not null, unique]
  headline varchar(255)
  summary text
  education_level varchar(100)
  gpa numeric(3,2)
  preferred_job_type varchar(50)
  preferred_working_model varchar(50)
  preferred_location varchar(255)
  education text
  experience text
  projects text
  target_position varchar(255)
  raw_text text
  processed_text text
  profile_completeness integer [not null, default: 0]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table companies {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  company_name varchar(255) [not null]
  tax_code varchar(100)
  website_url varchar(500)
  logo_url varchar(500)
  industry varchar(150)
  company_size varchar(100)
  description text
  address text
  phone varchar(50)
  status varchar(50) [not null, default: 'PENDING']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    status [name: 'idx_companies_status']
    company_name [name: 'idx_companies_company_name']
  }
}

Table skills {
  id bigint [pk, increment]
  name varchar(150) [not null, unique]
  normalized_name varchar(150)
  category varchar(100)
  description text
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    category [name: 'idx_skills_category']
  }
  Note: 'V11 partial unique index uk_skills_normalized_name ON (normalized_name) WHERE normalized_name IS NOT NULL.'
}

Table student_skills {
  id bigint [pk, increment]
  student_id bigint [not null]
  skill_id bigint [not null]
  level varchar(50) [not null]
  source varchar(50) [not null]
  years_of_experience numeric(4,1)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (student_id, skill_id) [unique, name: 'uk_student_skills_student_skill']
    skill_id [name: 'idx_student_skills_skill_id']
  }
}

Table jobs {
  id bigint [pk, increment]
  company_id bigint [not null]
  title varchar(255) [not null]
  description text [not null]
  requirements text
  benefits text
  location varchar(255)
  job_type varchar(50) [not null]
  working_model varchar(50) [not null]
  status varchar(50) [not null, default: 'DRAFT']
  salary_min numeric(14,2)
  salary_max numeric(14,2)
  currency varchar(10)
  deadline date
  published_at timestamp
  closed_at timestamp
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    company_id [name: 'idx_jobs_company_id']
    status [name: 'idx_jobs_status']
    job_type [name: 'idx_jobs_job_type']
    working_model [name: 'idx_jobs_working_model']
    deadline [name: 'idx_jobs_deadline']
  }
}

Table job_skills {
  id bigint [pk, increment]
  job_id bigint [not null]
  skill_id bigint [not null]
  importance varchar(50) [not null]
  min_level varchar(50)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (job_id, skill_id) [unique, name: 'uk_job_skills_job_skill']
    skill_id [name: 'idx_job_skills_skill_id']
  }
}

Table saved_jobs {
  id bigint [pk, increment]
  student_id bigint [not null]
  job_id bigint [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (student_id, job_id) [unique, name: 'uk_saved_jobs_student_job']
    job_id [name: 'idx_saved_jobs_job_id']
  }
}

Table cv_files {
  id bigint [pk, increment]
  student_id bigint [not null]
  file_name varchar(255) [not null]
  original_file_name varchar(255)
  stored_file_name varchar(255)
  file_url varchar(500) [not null]
  file_path varchar(500)
  content_type varchar(100)
  file_size bigint
  extracted_text text
  processed_text text
  extracted_skills jsonb [not null, default: `'[]'::jsonb`]
  analysis_status varchar(30) [not null, default: 'NOT_READY']
  analysis_error text
  language_code varchar(20)
  language_confidence numeric(5,4)
  processing_version varchar(100)
  analysis_warnings jsonb [not null, default: `'[]'::jsonb`]
  analyzed_at timestamp
  is_active boolean [not null, default: false]
  uploaded_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'V10 partial unique index uk_cv_files_student_active ON (student_id) WHERE is_active = TRUE. V15 CHECKs: analysis_status IN (NOT_READY, PROCESSING, READY, FAILED); nullable language_code IN (en, vi, mixed, unknown); nullable language_confidence BETWEEN 0 AND 1. READY alone does not guarantee V3-compatible metadata.'

  Indexes {
    student_id [name: 'idx_cv_files_student_id']
  }
}

Table applications {
  id bigint [pk, increment]
  student_id bigint [not null]
  job_id bigint [not null]
  cv_file_id bigint
  status varchar(50) [not null, default: 'PENDING']
  cover_letter text
  applied_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  reviewed_at timestamp
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    student_id [name: 'idx_applications_student_id']
    job_id [name: 'idx_applications_job_id']
    status [name: 'idx_applications_status']
  }
  Note: 'V18 drops uk_applications_student_job. Partial unique index uk_applications_student_job_active ON (student_id, job_id) WHERE status IN (PENDING, REVIEWED, ACCEPTED). DBML intentionally does not model this as lifetime uniqueness. Service additionally requires latest history REJECTED for reapplication; latest WITHDRAWN blocks it.'
}

Table recommendation_runs {
  id bigint [pk, increment]
  student_id bigint [not null]
  cv_file_id bigint
  source_type varchar(50) [not null]
  status varchar(50) [not null]
  algorithm varchar(100)
  algorithm_version varchar(100)
  total_jobs_scanned integer [not null, default: 0]
  started_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  finished_at timestamp
  error_message text
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    student_id [name: 'idx_recommendation_runs_student_id']
    status [name: 'idx_recommendation_runs_status']
  }
  Note: 'V15 CHECK total_jobs_scanned >= 0; index idx_recommendation_runs_student_status_created_at ON (student_id, status, created_at DESC, id DESC). No Student threshold/limit/request_id/fingerprint columns.'
}

Table recommendation_results {
  id bigint [pk, increment]
  run_id bigint [not null]
  job_id bigint [not null]
  score numeric(8,5) [not null]
  text_score numeric(8,5)
  skill_score numeric(8,5)
  scoring_strategy varchar(50)
  missing_skills jsonb [not null, default: `'[]'::jsonb`]
  reason text
  overall_score numeric(8,5)
  ranking_tier varchar(20)
  tier_rank_position integer
  matched_keywords jsonb
  rank_position integer [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (run_id, job_id) [unique, name: 'uk_recommendation_results_run_job']
    job_id [name: 'idx_recommendation_results_job_id']
    score [name: 'idx_recommendation_results_score']
  }
  Note: 'score is physical V3 rankingScore; no ranking_score column. Score CHECKs and V17 tier CHECKs are detailed in database-schema.md. Partial unique uk_recommendation_results_run_tier_rank ON (run_id, ranking_tier, tier_rank_position) WHERE ranking_tier IS NOT NULL AND tier_rank_position IS NOT NULL. idx_recommendation_results_score uses score DESC. No unique (run_id, rank_position) constraint for Student results. Historical incomplete rows may have null tier/ranks/components.'
}

Table notifications {
  id bigint [pk, increment]
  user_id bigint [not null]
  type varchar(50) [not null]
  title varchar(255) [not null]
  message text [not null]
  reference_type varchar(50)
  reference_id bigint
  is_read boolean [not null, default: false]
  read_at timestamp
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    user_id [name: 'idx_notifications_user_id']
    (user_id, is_read) [name: 'idx_notifications_user_read']
    created_at [name: 'idx_notifications_created_at']
  }
}

Table saved_candidates {
  id bigint [pk, increment]
  company_id bigint [not null]
  student_id bigint [not null]
  application_id bigint [not null]
  note text
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (company_id, student_id) [unique, name: 'uk_saved_candidates_company_student']
  }

  Note: '''Uniqueness is company_id + student_id; application_id records the source application, not Saved Application uniqueness.'''
}

Table user_notification_settings {
  id bigint [pk, increment]
  user_id bigint [not null]
  application_status_enabled boolean [not null, default: true]
  job_status_enabled boolean [not null, default: true]
  recommendation_enabled boolean [not null, default: true]
  system_enabled boolean [not null, default: true]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    user_id [unique, name: 'uk_user_notification_settings_user_id']
  }

  Note: '''V13 user_id is unique. Missing settings rows mean enabled in service behavior; GET does not create a row.'''
}

Table saved_searches {
  id bigint [pk, increment]
  student_id bigint [not null]
  name varchar(100) [not null]
  keyword varchar(255)
  location varchar(255)
  job_type varchar(50)
  working_model varchar(50)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Note: '''V14 expression unique index uk_saved_searches_student_name_ci ON (student_id, lower(name)); not an ordinary case-sensitive pair unique constraint.'''
}

Table candidate_ranking_runs {
  id bigint [pk, increment]
  job_id bigint [not null]
  request_id uuid [not null]
  status varchar(50) [not null]
  algorithm varchar(100)
  algorithm_version varchar(100)
  threshold numeric(8,5) [not null]
  requested_limit integer
  total_applications_scanned integer [not null, default: 0]
  eligible_candidates integer [not null, default: 0]
  skipped_no_cv integer [not null, default: 0]
  skipped_not_ready integer [not null, default: 0]
  skipped_terminal_status integer [not null, default: 0]
  input_fingerprint varchar(64) [not null]
  job_updated_at_snapshot timestamp [not null]
  started_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  finished_at timestamp
  error_message text
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  requested_primary_limit integer
  requested_fallback_limit integer

  Indexes {
    request_id [unique, name: 'uk_candidate_ranking_runs_request_id']
  }

  Note: '''V16/V17 CHECKs: status PROCESSING/SUCCESS/FAILED; threshold [0,1]; nonnegative counters sum to total_applications_scanned; fingerprint length 64. Either legacy requested_limit [1,100] with both tier limits NULL, or requested_limit NULL with both tier limits [0,100] and sum [1,100]. Partial unique uk_candidate_ranking_runs_job_processing ON (job_id) WHERE status = 'PROCESSING'. Index idx_candidate_ranking_runs_job_status_created_at ON (job_id, status, created_at DESC, id DESC).'''
}

Table candidate_ranking_results {
  id bigint [pk, increment]
  run_id bigint [not null]
  application_id bigint [not null]
  cv_file_id bigint [not null]
  score numeric(8,5) [not null]
  text_score numeric(8,5)
  skill_score numeric(8,5) [not null]
  scoring_strategy varchar(50) [not null]
  matched_skills jsonb [not null, default: `'[]'::jsonb`]
  missing_skills jsonb [not null, default: `'[]'::jsonb`]
  reason text
  rank_position integer [not null]
  cv_processing_version varchar(100)
  cv_analyzed_at_snapshot timestamp
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  overall_score numeric(8,5)
  ranking_tier varchar(20)
  tier_rank_position integer

  Indexes {
    (run_id, application_id) [unique, name: 'uk_candidate_ranking_results_run_application']
    (run_id, rank_position) [unique, name: 'uk_candidate_ranking_results_run_rank']
  }

  Note: '''score is physical V3 rankingScore. V16/V17 score/tier/strategy CHECKs in database-schema.md; matched_skills and missing_skills must be JSON arrays; rank_position > 0. Partial unique uk_candidate_ranking_results_run_tier_rank ON (run_id, ranking_tier, tier_rank_position) WHERE ranking_tier IS NOT NULL AND tier_rank_position IS NOT NULL. Historical nullable tier metadata is preserved.'''
}

Ref: students.user_id > users.id [delete: restrict]
Ref: student_profiles.student_id > students.id [delete: restrict]
Ref: companies.user_id > users.id [delete: restrict]
Ref: student_skills.student_id > students.id [delete: restrict]
Ref: student_skills.skill_id > skills.id [delete: restrict]
Ref: jobs.company_id > companies.id [delete: restrict]
Ref: job_skills.job_id > jobs.id [delete: restrict]
Ref: job_skills.skill_id > skills.id [delete: restrict]
Ref: saved_jobs.student_id > students.id [delete: restrict]
Ref: saved_jobs.job_id > jobs.id [delete: restrict]
Ref: cv_files.student_id > students.id [delete: restrict]
Ref: applications.student_id > students.id [delete: restrict]
Ref: applications.job_id > jobs.id [delete: restrict]
Ref: applications.cv_file_id > cv_files.id [delete: restrict]
Ref: recommendation_runs.student_id > students.id [delete: restrict]
Ref: recommendation_runs.cv_file_id > cv_files.id [delete: restrict]
Ref: recommendation_results.run_id > recommendation_runs.id [delete: restrict]
Ref: recommendation_results.job_id > jobs.id [delete: restrict]
Ref: notifications.user_id > users.id [delete: restrict]

Ref: saved_candidates.company_id > companies.id [delete: restrict]
Ref: saved_candidates.student_id > students.id [delete: restrict]
Ref: saved_candidates.application_id > applications.id [delete: restrict]
Ref: user_notification_settings.user_id > users.id [delete: restrict]
Ref: saved_searches.student_id > students.id [delete: restrict]
Ref: candidate_ranking_runs.job_id > jobs.id [delete: restrict]
Ref: candidate_ranking_results.run_id > candidate_ranking_runs.id [delete: restrict]
Ref: candidate_ranking_results.application_id > applications.id [delete: restrict]
Ref: candidate_ranking_results.cv_file_id > cv_files.id [delete: restrict]
