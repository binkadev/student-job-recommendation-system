# Local-development configuration only.
# Copy this file to .env before running Docker Compose.
# Never reuse these values in staging or production.

POSTGRES_DB=student_job_recommendation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-postgres-password
POSTGRES_PORT=5432

BACKEND_PORT=8080
AI_PORT=8000

APP_JWT_SECRET=change-this-local-jwt-secret-at-least-64-characters-before-shared-use
APP_JWT_EXPIRATION_MS=86400000

APP_CV_MAX_FILE_SIZE_BYTES=10485760
AI_CV_MAX_FILE_SIZE_BYTES=10485760
AI_INTERNAL_API_KEY=change-this-local-ai-internal-api-key-at-least-32-characters
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB

APP_AI_SERVICE_CONNECT_TIMEOUT=2s
APP_AI_SERVICE_READ_TIMEOUT=15s
APP_AI_CANDIDATE_RANKING_MAX_CANDIDATES_PER_REQUEST=500
APP_AI_CANDIDATE_RANKING_MAX_REQUEST_BYTES=8388608

JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
